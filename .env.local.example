RESEND_API_KEY=
ADMIN_PASSWORD=
# Google Tag Manager container ID (dạng GTM-XXXXXXX). Để trống thì không gắn tracking.
NEXT_PUBLIC_GTM_ID=
# Meta (Facebook) Pixel ID (dãy số). Để trống thì không gắn Pixel.
NEXT_PUBLIC_FB_PIXEL_ID=
# Chỉ cần đặt biến này trên Vercel (không đặt ở máy local) — khi có, admin sẽ lưu
# thay đổi bằng cách commit thẳng lên GitHub thay vì ghi file (vì Vercel không ghi
# được ổ đĩa lúc chạy). Lấy token bằng lệnh: gh auth token
GH_CONTENT_TOKEN=
